# Copy to .env beside compose.yaml, fill in every line that is not commented out, and keep the file private.
# docs/selfhosted/configuration.md explains each setting.

# The images: the release to run, and, for a mirror, where both images are published instead of ghcr.io/axonia-dev.
AXONIA_VERSION=
# AXONIA_IMAGE_REGISTRY=ghcr.io/axonia-dev

# The address members reach, through the TLS reverse proxy in front of the edge.
PUBLIC_URL=
# AXONIA_LISTEN=127.0.0.1:8080
# TRUSTED_PROXY_HOPS=1

# The company's identity provider, and the confidential client registered there for the edge.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email offline_access
OIDC_SESSION_END=revoke
SESSION_MAX_AGE_SECONDS=
AXONIA_SELFHOSTED_OIDC_AUDIENCE=
# AXONIA_SELFHOSTED_OIDC_SUBJECT_CLAIM=sub
# AXONIA_SELFHOSTED_OIDC_GROUPS_CLAIM=groups
# AXONIA_SELFHOSTED_OIDC_EMAIL_CLAIMS=email,preferred_username
# AXONIA_SELFHOSTED_OIDC_NAME_CLAIM=name

# The one Organization this installation serves.
AXONIA_SELFHOSTED_ORGANIZATION_ID=
AXONIA_SELFHOSTED_ORGANIZATION_NAME=
AXONIA_SELFHOSTED_OWNER_GROUP=

# The database, as compose runs it.
# DATABASE_URL=jdbc:postgresql://postgres:5432/axonia
# DATABASE_OWNER_USERNAME=axonia_owner

# Secrets: generate each once and keep it. Back AXONIA_SETTINGS_KEY up, kept apart from the database backups (docs/selfhosted/backup.md).
# Each of these five: openssl rand -hex 32
DATABASE_OWNER_PASSWORD=
DATABASE_PASSWORD=
DATABASE_COMMUNICATION_READ_PASSWORD=
EDGE_SHARED_SECRET=
AXONIA_UNSUBSCRIBE_SECRET=
# To rotate EDGE_SHARED_SECRET: set this to the new and the old one and recreate the backend, then set
# EDGE_SHARED_SECRET to the new one and recreate the edge, then remove this line and recreate the backend.
# AXONIA_EDGE_SHARED_SECRETS=new,old
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SESSION_COOKIE_KEY=
# openssl rand -base64 32
AXONIA_SETTINGS_KEY=
# AXONIA_SETTINGS_PREVIOUS_KEYS=

# With Entra ID as the identity provider: the app registration that reads group members and profile photos
# (docs/selfhosted/entra.md).
# AXONIA_ENTRA_CLIENT_ID=
# AXONIA_ENTRA_CLIENT_SECRET=

# The hosts an AI agent may name as its client, claude.ai unless set; an empty value trusts none
# (docs/selfhosted/configuration.md).
# AXONIA_MCP_OAUTH_TRUSTED_CLIENT_DOMAINS=claude.ai

# Images stay on the media volume unless APP_MEDIA_TYPE names s3 or azure-blob (docs/selfhosted/storage.md). Set only
# the lines that store needs, and leave the others out rather than empty.
# APP_MEDIA_TYPE=s3
# APP_MEDIA_S3_BUCKET=
# APP_MEDIA_S3_REGION=
# APP_MEDIA_S3_ENDPOINT=
# APP_MEDIA_S3_PATH_STYLE=true
# APP_MEDIA_S3_ACCESS_KEY=
# APP_MEDIA_S3_SECRET_KEY=
# APP_MEDIA_AZURE_BLOB_ENDPOINT=
# APP_MEDIA_AZURE_BLOB_CONTAINER=

# Rate-limit budgets are kept in memory, one set per backend instance; more than one instance keeps them in Redis.
# AXONIA_RATE_LIMIT_STORE=redis
# SPRING_DATA_REDIS_URL=rediss://:<password>@redis.example.com:6380
# MANAGEMENT_HEALTH_REDIS_ENABLED=true

# The mail server is configured in the application (Settings, Notifications). Each of these overrides one field and
# locks it there once compose.override.yaml passes it to the backend (docs/selfhosted/configuration.md, Docker Compose).
# AXONIA_MAIL_HOST=
# AXONIA_MAIL_PORT=
# AXONIA_MAIL_SECURITY=
# AXONIA_MAIL_USERNAME=
# AXONIA_MAIL_PASSWORD=
# AXONIA_MAIL_FROM_ADDRESS=
# AXONIA_MAIL_FROM_NAME=
