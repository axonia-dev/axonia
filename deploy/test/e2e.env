# The end-to-end stack's settings (compose.test.yaml). Test only: every secret here is public, and spelled as such.
AXONIA_IMAGE_REGISTRY=axonia-e2e
AXONIA_VERSION=e2e
AXONIA_LISTEN=127.0.0.1:18083
PUBLIC_URL=http://localhost:18083
OIDC_ISSUER=http://localhost:18082/axonia
OIDC_CLIENT_ID=axonia-e2e
OIDC_CLIENT_SECRET=e2e-only-client-secret
OIDC_SCOPES=openid profile email offline_access
OIDC_SESSION_END=revoke
SESSION_COOKIE_KEY=ZTJlLW9ubHktc2Vzc2lvbi1rZXktbm90LXNlY3JldCE
SESSION_MAX_AGE_SECONDS=3600
TRUSTED_PROXY_HOPS=0
EDGE_SHARED_SECRET=e2e-only-edge-secret
DATABASE_OWNER_PASSWORD=e2e-only-owner
DATABASE_PASSWORD=e2e-only-app
DATABASE_COMMUNICATION_READ_PASSWORD=e2e-only-read
AXONIA_UNSUBSCRIBE_SECRET=e2e-only-unsubscribe
AXONIA_SETTINGS_KEY=ZTJlLW9ubHktc2V0dGluZ3Mta2V5LW5vdC1zZWNyZXQ=
AXONIA_SELFHOSTED_ORGANIZATION_ID=e2e
AXONIA_SELFHOSTED_ORGANIZATION_NAME=Example Company
AXONIA_SELFHOSTED_OWNER_GROUP=axonia-owners
AXONIA_SELFHOSTED_OIDC_AUDIENCE=axonia-e2e
