{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["publicUrl", "organization", "ownerGroup", "oidc", "database", "existingSecret", "backend", "edge"],
  "definitions": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
    "optionalString": { "type": "string" },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "key"],
      "properties": {
        "existingSecret": { "type": "string" },
        "key": { "$ref": "#/definitions/nonEmpty" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "$ref": "#/definitions/nonEmpty" },
        "tag": { "type": "string" }
      }
    },
    "envList": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "$ref": "#/definitions/nonEmpty" } } }
    },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "workload": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "extraEnv": { "$ref": "#/definitions/envList" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    }
  },
  "properties": {
    "fullnameOverride": { "type": "string", "maxLength": 50, "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$" },
    "publicUrl": {
      "type": "string",
      "pattern": "^(https://[A-Za-z0-9.-]+(:[0-9]{1,5})?|http://(localhost|127\\.0\\.0\\.1)(:[0-9]{1,5})?)$",
      "description": "https and no path, or http on localhost"
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "allOf": [{ "$ref": "#/definitions/nonEmpty" }], "maxLength": 120 }
      }
    },
    "ownerGroup": { "$ref": "#/definitions/nonEmpty" },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "clientId", "scopes", "sessionEnd", "sessionMaxAgeSeconds"],
      "properties": {
        "issuer": { "type": "string", "pattern": "^(https://\\S+|http://(localhost|127\\.0\\.0\\.1)(:[0-9]{1,5})?(/\\S*)?)$" },
        "clientId": { "$ref": "#/definitions/nonEmpty" },
        "audience": { "type": "string" },
        "scopes": { "type": "string", "pattern": "(^|\\s)openid(\\s|$)" },
        "sessionEnd": { "enum": ["revoke", "refresh-token-post"] },
        "sessionMaxAgeSeconds": { "type": "integer", "minimum": 1, "maximum": 63072000 },
        "subjectClaim": { "$ref": "#/definitions/nonEmpty" },
        "groupsClaim": { "$ref": "#/definitions/nonEmpty" },
        "emailClaims": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/nonEmpty" } },
        "nameClaim": { "$ref": "#/definitions/nonEmpty" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "ownerUsername"],
      "properties": {
        "url": { "type": "string", "pattern": "^jdbc:postgresql://\\S+$" },
        "ownerUsername": { "$ref": "#/definitions/nonEmpty" }
      }
    },
    "existingSecret": { "$ref": "#/definitions/nonEmpty" },
    "settingsKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "existingSecret": { "type": "string" } }
    },
    "mail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "security": { "enum": ["", "STARTTLS", "TLS", "NONE"] },
        "username": { "type": "string" },
        "password": { "$ref": "#/definitions/secretRef" },
        "fromAddress": { "type": "string" },
        "fromName": { "type": "string" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["local", "s3", "azure-blob"] },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": { "type": "string" },
            "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
            "storageClassName": { "type": "string" },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"] }
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bucket": { "type": "string" },
            "region": { "type": "string" },
            "endpoint": { "type": "string", "pattern": "^(https?://\\S+)?$" },
            "pathStyle": { "type": "boolean" },
            "existingSecret": { "type": "string" }
          }
        },
        "azureBlob": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": { "type": "string", "pattern": "^(https://\\S+)?$" },
            "container": { "type": "string" }
          }
        }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store": { "enum": ["memory", "redis"] },
        "redis": { "$ref": "#/definitions/secretRef" }
      }
    },
    "entraGraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientId": { "type": "string" },
        "clientSecret": { "$ref": "#/definitions/secretRef" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array", "items": { "type": "object", "required": ["name"] } }
      }
    },
    "backend": {
      "allOf": [{ "$ref": "#/definitions/workload" }],
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": true,
        "replicas": true,
        "resources": true,
        "podLabels": true,
        "podAnnotations": true,
        "extraEnv": true,
        "nodeSelector": true,
        "tolerations": true,
        "affinity": true,
        "javaToolOptions": { "type": "string" },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "annotations": { "$ref": "#/definitions/stringMap" } }
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "allOf": [{ "$ref": "#/definitions/workload" }],
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": true,
        "replicas": true,
        "resources": true,
        "podLabels": true,
        "podAnnotations": true,
        "extraEnv": true,
        "nodeSelector": true,
        "tolerations": true,
        "affinity": true,
        "trustedProxyHops": { "type": "integer", "minimum": 0, "maximum": 10 }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "authAnnotations": { "$ref": "#/definitions/stringMap" },
        "tlsSecretName": { "type": "string" }
      }
    }
  }
}
