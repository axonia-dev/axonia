# The Self-hosted edition's dev server (pnpm dev:selfhosted), beside the backend of its DEV run on
# 8090 and the identity provider of deploy/dev/compose.yaml, whose README has the steps. Its sign-in
# asks for a refresh token and ends a session by revoking it, as a company's identity provider
# expects. Read by the dev server only, never by the bundle: no VITE_ prefix.
DEV_PORT=3200
DEV_BACKEND_ORIGIN=http://localhost:8090
DEV_OIDC_ISSUER=http://localhost:8091/axonia
DEV_OIDC_CLIENT_ID=axonia-local
DEV_OIDC_SCOPES=openid profile email offline_access
DEV_OIDC_SESSION_END=revoke
DEV_COOKIE_NAME_PREFIX=axonia-selfhosted
