  },
  {
    "name": "quotes are escaped",
    "input": "say \"hi\"",
    "html": "<p>say &quot;hi&quot;</p>"
  },
  {
    "name": "an item keeps every line and every list it holds",
    "input": "- a\n\n  3. x\n\n  1. y\n\n  - b\n\n  7. q",
    "html": "<ul><li>a<br>3. x<ol><li>y</li><li>b</li></ol>7. q</li></ul>"
  },
  {
    "name": "lists of another kind in one item join the first",
