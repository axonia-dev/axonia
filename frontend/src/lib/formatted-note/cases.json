    "html": "<p>x</p>"
  },
  {
    "name": "mailto link keeps only its label",
    "input": "[mail](mailto:a@b.com)",
    "html": "<p>mail</p>"
  },
  {
    "name": "relative link keeps only its label",
    "input": "[x](/path)",
