    "html": "<p>2025. was a good year</p>"
  },
  {
    "name": "a number with a parenthesis stays text",
    "input": "3) third",
    "html": "<p>3) third</p>"
  },
  {
    "name": "a year at line start keeps its formatting and links",
    "input": "2025. was a **great** year, see https://a.com",
    "html": "<p>2025. was a <strong>great</strong> year, see <a href=\"https://a.com\">https://a.com</a></p>"
  },
  {
    "name": "consecutive numbered lines from a year stay one paragraph",
