    "input": "One\n\nTwo",
    "html": "<p>One</p><p>Two</p>"
  },
  {
    "name": "bold in both spellings",
    "input": "**bold** and __also__",
    "html": "<p><strong>bold</strong> and <strong>also</strong></p>"
  },
  {
