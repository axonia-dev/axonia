    "html": "<p>Go to <a href=\"https://example.com\">https://example.com</a>.</p>"
  },
  {
    "name": "www without a scheme stays text",
    "input": "www.example.com",
    "html": "<p>www.example.com</p>"
  },
  {
    "name": "email address stays text",
    "input": "a@b.com",
    "html": "<p>a@b.com</p>"
  },
  {
    "name": "javascript link keeps only its label",
