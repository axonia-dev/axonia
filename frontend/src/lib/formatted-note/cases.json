    "input": "[old](http://example.com)",
    "html": "<p><a href=\"http://example.com\">old</a></p>"
  },
  {
    "name": "bare url",
    "input": "See https://example.com/a for more",
    "html": "<p>See <a href=\"https://example.com/a\">https://example.com/a</a> for more</p>"
  },
  {
    "name": "bare url drops a trailing full stop",
