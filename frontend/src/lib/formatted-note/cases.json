  },
  {
    "name": "image stays text",
    "input": "![alt](https://example.com/x.png)",
    "html": "<p>![alt](https://example.com/x.png)</p>"
  },
  {
    "name": "entities decode",
    "input": "Q&amp;A &copy;",
    "html": "<p>Q&amp;A ©</p>"
  },
  {
    "name": "backslash escapes",
