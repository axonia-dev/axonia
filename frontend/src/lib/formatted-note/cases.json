    "html": "<ul><li>item<br>continued</li></ul>"
  },
  {
    "name": "paragraph then list",
    "input": "Two incidents.\n\n- **Quota alerts** page the team\n- see [notes](https://e.com)",
    "html": "<p>Two incidents.</p><ul><li><strong>Quota alerts</strong> page the team</li><li>see <a href=\"https://e.com\">notes</a></li></ul>"
  },
  {
    "name": "heading stays text",
