    "html": "<ul><li>a</li><li>b</li></ul>"
  },
  {
    "name": "numbered list from one",
    "input": "1. one\n2. two",
    "html": "<ol><li>one</li><li>two</li></ol>"
  },
  {
    "name": "numbered list with parentheses from one",
    "input": "1) one\n2) two",
    "html": "<ol><li>one</li><li>two</li></ol>"
  },
  {
    "name": "a year at line start stays text",
