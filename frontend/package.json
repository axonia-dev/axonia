{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "node edition.mjs dev",
    "build": "node edition.mjs build",
    "lint": "oxlint --type-aware && eslint .",
    "lint:fix": "oxlint --type-aware --fix && eslint . --fix",
    "preview": "node edition.mjs preview",
    "test": "node edition.mjs test",
    "test:watch": "node edition.mjs test:watch",
    "test:cov": "node edition.mjs test:cov",
    "typecheck": "node edition.mjs typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dup": "node edition.mjs dup",
    "knip": "node edition.mjs knip",
    "test:e2e": "node edition.mjs test:e2e",
    "og:card": "node edition.mjs og:card",
    "emoji:generate": "node scripts/generate-emoji-catalog.mjs",
    "verify": "node edition.mjs verify",
    "dev:cloud": "vite",
    "build:cloud": "tsc -b && vite build && vite build --ssr src/cloud/prerender.tsx && node scripts/prerender.mjs",
    "preview:cloud": "vite preview",
    "test:cloud": "vitest run",
    "test:watch:cloud": "vitest",
    "test:cov:cloud": "vitest run --coverage",
    "typecheck:cloud": "tsc -b",
    "dup:cloud": "jscpd",
    "knip:cloud": "knip",
    "test:e2e:cloud": "playwright test",
    "og:card:cloud": "node scripts/og-card.mjs",
    "verify:cloud": "pnpm run typecheck:cloud && pnpm run lint && pnpm run format:check && pnpm run test:cov:cloud && pnpm run dup:cloud && pnpm run knip:cloud && pnpm run build:cloud",
    "dev:selfhosted": "vite --config vite.selfhosted.config.ts --mode selfhosted",
    "build:selfhosted": "tsc -b tsconfig.selfhosted.json && vite build --config vite.selfhosted.config.ts --mode selfhosted",
    "preview:selfhosted": "vite preview --config vite.selfhosted.config.ts --mode selfhosted",
    "test:selfhosted": "vitest run --config vite.selfhosted.config.ts --mode selfhosted",
    "test:watch:selfhosted": "vitest --config vite.selfhosted.config.ts --mode selfhosted",
    "test:cov:selfhosted": "vitest run --config vite.selfhosted.config.ts --mode selfhosted --coverage",
    "typecheck:selfhosted": "tsc -b tsconfig.selfhosted.json tsconfig.node.json tsconfig.e2e.json",
    "dup:selfhosted": "jscpd --config .jscpd.selfhosted.json",
    "knip:selfhosted": "knip --config knip.selfhosted.json",
    "test:e2e:selfhosted": "playwright test --config playwright.selfhosted.config.ts",
    "verify:selfhosted": "pnpm run typecheck:selfhosted && pnpm run lint && pnpm run format:check && pnpm run test:cov:selfhosted && pnpm run dup:selfhosted && pnpm run knip:selfhosted && pnpm run build:selfhosted"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@grafana/faro-web-sdk": "^2.12.1",
    "@grafana/faro-web-tracing": "^2.12.1",
    "@internationalized/date": "^3.12.4",
    "@mdx-js/react": "^3.1.1",
    "@paddle/paddle-js": "^1.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jscpd": "^5.4.0",
    "jsdom": "~30.0.1",
    "knip": "6.39.0",
    "lint-staged": "17.6.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "unicode-emoji-json": "^0.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
