# Mark every Lombok-generated member with @lombok.Generated. JaCoCo 0.8+ and
# SpotBugs both skip @Generated members, so generated code is never counted
# against coverage or flagged for bugs. This file being at the module root
# (with stopBubbling) is what makes Lombok resolve it for every module's src.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
